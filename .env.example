# Required by Playwright configuration for all test runs.
BASE_URL=https://www.saucedemo.com
DEMOQA_BASE_URL=https://demoqa.com

# Opt in only for isolated test environments that own the accounts being cleaned up.
ALLOW_DESTRUCTIVE_CLEANUP=false

# Required only by tests that call getTestCredentials().
TEST_USERNAME=your_test_username
TEST_PASSWORD=your_test_password
